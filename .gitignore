# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
env/
venv/
ENV/

# Secrets and local configuration (never commit real values)
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# Game binaries and large assets (preserved on disk, ignored in git)
reference/
*.ipa
*.apk
*.adbk
# Database & runtime data
*.db
data/*.db
data/assets/*/
data/assets-cdn/
data/manifest/*.json
data/hexdata/*/
data/photos/
# Game metadata (never commit game metadata)
data/metadata/

# TLS material is generated locally, never distributed. Run:
#   python -m dankagu.core.certs
certs/

# Protocol schemas are third-party content and are not redistributed here.
# Fetch them with: python scripts/compile_protos.py --fetch
# See THIRD_PARTY_NOTICES.md for the source and its license.
protos/
vendor-protos/

# Generated protobuf/gRPC stubs are build output, not source. They are
# recreated by: python scripts/compile_protos.py
src/dankagu/grpc/generated/

# IDE & OS
.idea/
# `.vscode/*` rather than `.vscode/`: git does not descend into an excluded
# directory, so the negations below would never take effect otherwise.
.vscode/*
# ...but keep the shared editor configuration so ruff behaviour in the editor
# stays identical to the checks CI runs. Everything else under .vscode/ stays
# ignored.
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/README.md
*.swp
*.swo
*~
Thumbs.db
.DS_Store

# Temporary outputs
scratch/
tmp/
audit_mock.py

# Local working directories
work/
out/

server.log
certs/*.crt
certs/*.key