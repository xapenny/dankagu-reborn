# =============================================================================
# Danmaku Kagura backend preservation server - configuration TEMPLATE
# =============================================================================
# Copy this file to `.env` and fill in the values. `.env` is git-ignored and
# must never be committed; this template is safe to commit because it contains
# no real values. Real environment variables take precedence over `.env`.
#
#   cp .env.example .env
#
# All variables use the DANKAGU_ prefix.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED SECRETS
# -----------------------------------------------------------------------------
# HMAC key used to sign LCX JWT tokens. REQUIRED - token issuance fails without
# it. Generate a fresh value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DANKAGU_JWT_SECRET=

# 32-byte Takasho transport key used by your client build, as 64 hex
# characters. This is NOT distributed with this project and must be supplied
# by you. See the README "Configuration" section.
#
# Without it the server falls back to the public development key, which only
# works with development builds of the client; a release client will fail to
# decrypt responses.
DANKAGU_TAKASHO_KEY_HEX=


# -----------------------------------------------------------------------------
# NETWORK
# -----------------------------------------------------------------------------
# Interface to bind. Keep 0.0.0.0 to serve LAN devices.
DANKAGU_HOST=0.0.0.0

# Pin the LAN IP advertised to clients and baked into the certificate SANs.
# Leave empty to auto-detect.
DANKAGU_LAN_IP=

# Ports. 443 requires elevated privileges on most systems; use 9443 if you
# cannot bind it.
DANKAGU_LCX_IOS_PORT=443
DANKAGU_LCX_PORT=9443
DANKAGU_GRPC_PORT=50051
DANKAGU_GRPC_TLS_PORT=50052
DANKAGU_ASSET_PORT=8080

# Master switch for the plain-HTTP portal & asset CDN listener (default: true).
# Set to false to leave DANKAGU_ASSET_PORT completely unbound - useful when the
# port clashes with something else, or when you do not want a plaintext listener
# on the LAN.
#
# This is also the switch for the whole operator surface. The setup portal
# (http://<LAN_IP>:8080/), /ca.crt, /cert, /server.crt and /status are served on
# this listener and nowhere else, so turning it off removes them completely.
# Install certs/ca.crt on your devices by other means in that case.
#
# What keeps working: the game's own routes - /assets, /ver, /static, /photos -
# stay reachable over HTTPS, because the LCX apps on 443/9443 mount the asset
# router. /status does NOT survive there, by design.
DANKAGU_ASSET_SERVER_ENABLED=true

# Log level: DEBUG, INFO, WARNING or ERROR. Use WARNING on a deployed server.
DANKAGU_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# PUBLIC IDENTITY
# -----------------------------------------------------------------------------
# The hostname your client is configured to reach. When set it becomes the
# certificate's Common Name and is added to its SAN list, and is used for
# absolute URLs (e.g. announcement images) served to the client.
# Example: DANKAGU_PUBLIC_HOST=danmaku.example.com
DANKAGU_PUBLIC_HOST=

# Override the base URL used for absolute links, if it differs from the
# automatic choice of https://<PUBLIC_HOST> or http://<LAN_IP>:<ASSET_PORT>.
DANKAGU_PUBLIC_BASE_URL=

# Additional certificate SAN entries, comma-separated.
DANKAGU_EXTRA_CERT_DNS_NAMES=


# -----------------------------------------------------------------------------
# STORAGE
# -----------------------------------------------------------------------------
# Database connection URL (PostgreSQL with asyncpg driver).
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/dankagu
DANKAGU_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dankagu

# Schema versioning (Alembic - see src/dankagu/db/README.md).
# Apply pending migrations during startup, before any listener binds. Safe on a
# live server: a database created before Alembic existed is stamped with the
# baseline revision instead of being re-created, and a database that is already
# at head skips the whole step. Set to false when your deployment script runs
# `python -m dankagu.db.migrate --upgrade` itself.
DANKAGU_DB_AUTO_MIGRATE=true

# How long to wait for another instance to finish migrating before startup fails
# (the lock also covers a slow data backfill).
DANKAGU_DB_MIGRATE_WAIT_SECONDS=300
